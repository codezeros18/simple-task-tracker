# Postgres credentials (also used by docker-compose to create the database)
POSTGRES_USER=tasks_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tasks
# Database used by pytest (created automatically by docker-compose)
TEST_POSTGRES_DB=tasks_test
# Where the API connects. docker-compose maps the DB to port 5433 on your machine.
DB_HOST=localhost
DB_PORT=5433
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
